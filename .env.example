# ═══════════════════════════════════════════════════════════════════════════════
# 智能语音助手 - 环境变量配置文件
# ═══════════════════════════════════════════════════════════════════════════════
#
# 使用方法：
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 修改下方的 API Key 和配置
#   3. 运行程序: uv run python main.py
#
# 配置优先级：.env > 环境变量 > 默认值
#
# ═══════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 📋 快速配置指南（必填）                                                      │
# └─────────────────────────────────────────────────────────────────────────────┘

# ───────────────────────────────────────────────────────────────────────────────
# 1️⃣ LLM 服务配置（选择一个）
# ───────────────────────────────────────────────────────────────────────────────

# 选择 LLM 服务提供商: qwen | deepseek | openai | anthropic
LLM_SERVICE=qwen

# Qwen（阿里云 DashScope）- 推荐，中文优化
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-plus
# 可选模型: qwen-plus | qwen-max | qwen-turbo

# DeepSeek（强推理，低成本）- 取消注释以使用
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI（GPT-4o, o1 等）- 取消注释以使用
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# Anthropic Claude（支持 Thinking 模式）- 取消注释以使用
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ───────────────────────────────────────────────────────────────────────────────
# 2️⃣ TTS 语音合成配置（选择一个）
# ───────────────────────────────────────────────────────────────────────────────

# 选择 TTS 引擎: piper | dashscope | dashscope_realtime | edge | azure
TTS_SERVICE=piper

# 【推荐配置对比】
# ├─ piper               本地引擎，<100ms 延迟，免费，推荐开发环境 ⭐
# ├─ dashscope_realtime   WebSocket 实时，~100-200ms 延迟，推荐生产环境 🆕
# └─ dashscope           HTTP 流式，~300ms 延迟，稳定可靠

# Piper TTS（本地，无需配置 API Key）⭐ 推荐
# 模型会自动下载到 models/piper/ 目录

# DashScope Realtime TTS（WebSocket，低延迟）🆕
# 取消下方注释以使用（推荐生产环境）
# 注意：需要配置 QWEN_API_KEY（上面已配置）
# TTS_SERVICE=dashscope_realtime
# DASHSCOPE_REALTIME_MODEL=qwen3-tts-flash-realtime
# DASHSCOPE_REALTIME_VOICE=Cherry
# DASHSCOPE_REALTIME_MODE=server_commit

# DashScope TTS（HTTP 流式，稳定）
# 取消下方注释以使用
# TTS_SERVICE=dashscope
# DASHSCOPE_TTS_MODEL=qwen3-tts-flash
# DASHSCOPE_TTS_VOICE=Cherry

# ───────────────────────────────────────────────────────────────────────────────
# 3️⃣ 音频设备配置（可选）
# ───────────────────────────────────────────────────────────────────────────────

# 查看可用设备: python list_audio_devices.py
# 避免选择"立体声混音"设备，否则会收录系统声音
# AUDIO_INPUT_DEVICE_INDEX=1
# AUDIO_OUTPUT_DEVICE_INDEX=5

# ═══════════════════════════════════════════════════════════════════════════════
# 📖 高级配置（可选，按需配置）
# ═══════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 🧠 LLM 服务详细配置                                                           │
# └─────────────────────────────────────────────────────────────────────────────┘

# Qwen 高级配置
# QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus | qwen-max | qwen-turbo
# 本地部署示例: QWEN_API_URL=http://localhost:4000/v1, QWEN_MODEL=Local1-Qwen3-235B

# DeepSeek 高级配置
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat | deepseek-reasoner

# OpenAI 高级配置
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o | gpt-4 | o1-preview | o1-mini

# Anthropic Claude 高级配置（官方 Claude / 智谱 GLM）
# ANTHROPIC_API_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-opus-4-6 | claude-sonnet-4-5-20250929
# 智谱 GLM 兼容配置:
#   ANTHROPIC_API_URL=https://open.bigmodel.cn/api/anthropic
#   ANTHROPIC_MODEL=glm-4.7
# ANTHROPIC_ENABLE_THINKING=false  # 是否启用 Thinking 模式
# ANTHROPIC_THINKING_EFFORT=medium # high | medium | low

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 🔊 TTS 语音合成详细配置                                                       │
# └─────────────────────────────────────────────────────────────────────────────┘

# ───────────────────────────────────────────────────────────────────────────────
# Piper TTS（本地引擎）
# ───────────────────────────────────────────────────────────────────────────────
# 模型路径（自动下载，无需手动配置）
# PIPER_TTS_MODEL_PATH=models/piper/zh_CN-huayan-medium.onnx

# 🔧 合成参数（调节音色和语速）
PIPER_LENGTH_SCALE=1.0    # 语速 (0.5-2.0, 1.0 = 正常, <1 = 快, >1 = 慢)
PIPER_VOLUME=1.0          # 音量 (0.1-2.0, 1.0 = 正常, <1 = 小声, >1 = 大声)
PIPER_NOISE_SCALE=0.667   # 音频变化 (0.1-1.0, 0.667 = 自然, 越高越有表现力)
PIPER_NOISE_W_SCALE=0.8   # 说话变化 (0.1-1.0, 0.8 = 自然, 越高越有抑扬顿挫)
PIPER_NORMALIZE_AUDIO=true # 是否标准化音频 (true | false)

# 📋 推荐配置方案：
# 【自然清晰】(默认)
#   PIPER_LENGTH_SCALE=1.0
#   PIPER_NOISE_SCALE=0.667
#   PIPER_NOISE_W_SCALE=0.8
#
# 【快速活泼】
#   PIPER_LENGTH_SCALE=0.8
#   PIPER_NOISE_SCALE=0.8
#   PIPER_NOISE_W_SCALE=0.9
#
# 【慢速沉稳】
#   PIPER_LENGTH_SCALE=1.2
#   PIPER_NOISE_SCALE=0.6
#   PIPER_NOISE_W_SCALE=0.7

# ───────────────────────────────────────────────────────────────────────────────
# DashScope Realtime TTS（WebSocket 实时）⭐ 推荐
# ───────────────────────────────────────────────────────────────────────────────
# 模型选择
# DASHSCOPE_REALTIME_MODEL=qwen3-tts-flash-realtime | qwen3-tts-instruct-flash-realtime

# 音色选择
# DASHSCOPE_REALTIME_VOICE=Cherry | Ethan | Sunny | Dylan

# 交互模式
# DASHSCOPE_REALTIME_MODE=server_commit  # server_commit（自动）| commit（手动）

# 高级参数
# DASHSCOPE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# DASHSCOPE_REALTIME_LANGUAGE_TYPE=Chinese
# DASHSCOPE_REALTIME_SPEECH_RATE=1.0      # [0.5, 2.0]
# DASHSCOPE_REALTIME_VOLUME=50            # [0, 100]
# DASHSCOPE_REALTIME_PITCH_RATE=1.0       # [0.5, 2.0]

# 指令控制（仅 qwen3-tts-instruct-flash-realtime）
# DASHSCOPE_REALTIME_INSTRUCTIONS=语速较快，带有明显的上扬语调
# DASHSCOPE_REALTIME_OPTIMIZE_INSTRUCTIONS=true

# ───────────────────────────────────────────────────────────────────────────────
# DashScope TTS（HTTP 流式）
# ───────────────────────────────────────────────────────────────────────────────
# DASHSCOPE_TTS_MODEL=qwen3-tts-flash | qwen3-tts-instruct-flash
# DASHSCOPE_TTS_VOICE=Cherry

# ───────────────────────────────────────────────────────────────────────────────
# Edge TTS（微软免费）
# ───────────────────────────────────────────────────────────────────────────────
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ───────────────────────────────────────────────────────────────────────────────
# Azure TTS（高质量付费）
# ───────────────────────────────────────────────────────────────────────────────
# AZURE_TTS_API_KEY=your-azure-api-key-here
# AZURE_TTS_REGION=eastasia
# AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 👁️ Vision 视觉理解配置                                                       │
# └─────────────────────────────────────────────────────────────────────────────┘

# 选择 Vision 服务: moondream | qwen-vl-plus | qwen-vl-max
VISION_SERVICE=moondream

# Moondream 本地模型
# MOONDREAM_USE_CPU=false  # false（GPU 加速）| true（CPU 模式）

# Qwen-VL API
# QWEN_VL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VL_API_KEY=your-dashscope-api-key-here

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 🔧 MCP 工具配置                                                               │
# └─────────────────────────────────────────────────────────────────────────────┘

# MCP (Model Context Protocol) 工具通过 config/mcp_servers.json 配置
# 支持的工具：
#   - playwright: 浏览器自动化（默认启用）
#   - windows: Windows 系统操作
#   - filesystem: 文件系统操作
#   - github: GitHub 操作
#
# 配置方法：
#   1. 编辑 config/mcp_servers.json
#   2. 设置 enabled: true 启用工具
#   3. 重启程序生效

# ═══════════════════════════════════════════════════════════════════════════════
# 📚 配置说明和最佳实践
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# 推荐配置方案
# ───────────────────────────────────────────────────────────────────────────────
#
# 【方案 1】开发环境（免费，快速）
#   LLM_SERVICE=qwen
#   TTS_SERVICE=piper
#   VISION_SERVICE=moondream
#
# 【方案 2】生产环境（低延迟，高质量）⭐
#   LLM_SERVICE=qwen
#   TTS_SERVICE=dashscope_realtime  # WebSocket 实时
#   VISION_SERVICE=qwen-vl-plus
#
# 【方案 3】最低延迟（实时对话）
#   LLM_SERVICE=qwen
#   TTS_SERVICE=dashscope_realtime
#   DASHSCOPE_REALTIME_MODE=commit  # 手动模式
#
# ───────────────────────────────────────────────────────────────────────────────
# API Key 获取
# ───────────────────────────────────────────────────────────────────────────────
# Qwen:     https://dashscope.console.aliyun.com/
# DeepSeek: https://platform.deepseek.com/
# OpenAI:   https://platform.openai.com/
# Anthropic:https://console.anthropic.com/
#
# ───────────────────────────────────────────────────────────────────────────────
# 性能对比
# ───────────────────────────────────────────────────────────────────────────────
# TTS 引擎对比：
#   Piper:           <100ms  ⭐⭐⭐  免费      开发环境
#   WebSocket Realtime: ~100-200ms  ⭐⭐⭐⭐⭐  低费用  生产环境 ⭐
#   HTTP DashScope:  ~300ms  ⭐⭐⭐⭐⭐  低费用  稳定可靠
#   Edge TTS:        ~500ms  ⭐⭐     免费      备用方案
#   Azure TTS:       ~400ms  ⭐⭐⭐⭐⭐  高费用  高质量
#
# ═══════════════════════════════════════════════════════════════════════════════

# ==================== LLM 配置 ====================
# 指定使用哪个 LLM 服务：qwen | deepseek | openai | anthropic
LLM_SERVICE=qwen

# Qwen (阿里云 DashScope) 配置组
QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 可选模型：qwen-plus, qwen-max, qwen-turbo
# 本地部署示例：QWEN_API_URL=http://localhost:4000/v1, QWEN_MODEL=Local1-Qwen3-235B

# DeepSeek 配置组
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# 可选模型：deepseek-chat, deepseek-reasoner

# OpenAI 配置组
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# 可选模型：gpt-4o, gpt-4, gpt-3.5-turbo, o1-preview, o1-mini

# Anthropic Messages API 配置组
# 支持 Pipecat 官方 AnthropicLLMService
# 可兼容官方 Claude API 和任何兼容该规范的本地/云端服务
#
# 官方 Claude 使用示例：
# LLM_SERVICE=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_API_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
#
# 智谱 GLM 使用示例（兼容 Anthropic API）：
# LLM_SERVICE=anthropic
# ANTHROPIC_API_KEY=your-zhipu-api-key
# ANTHROPIC_API_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_MODEL=glm-4.7
#
# 可选模型（官方 Claude）：
#   - claude-opus-4-6（最强推理，支持自适应思考）
#   - claude-sonnet-4-5-20250929（推荐，平衡性能）
#   - claude-sonnet-4-6（最新）
#   - claude-3-5-haiku（快速）
#
# 可选模型（智谱 GLM）：
#   - glm-4.7（最新）
#   - glm-4-plus
#   - glm-4-flash
#   - glm-4-air
#
# 注意：
# - 智谱 GLM API 兼容 Anthropic Messages API 规范
# - 使用 Pipecat 官方 AnthropicLLMService，无需自定义代码
# - Function Calling 支持（官方实现）

# ==================== TTS 服务配置 ====================
# 指定使用哪个 TTS 引擎：piper | dashscope | edge | azure | coqui
TTS_SERVICE=piper

# Piper TTS 配置（本地，最快，延迟<100ms，推荐）
# 可选模型路径，默认使用 models/piper/zh_CN-huayan-medium.onnx
# PIPER_TTS_MODEL_PATH=models/piper/zh_CN-huayan-medium.onnx

# DashScope TTS 配置（阿里云，音质好）
# 支持流式合成，边生成边播放，低延迟
# 注意：使用上面 LLM 配置中的 DASHSCOPE_API_KEY，无需额外配置
# TTS_SERVICE=dashscope
# DASHSCOPE_TTS_MODEL=qwen3-tts-flash
# DASHSCOPE_TTS_VOICE=Cherry
#
# 可选模型：
# - qwen3-tts-flash（默认，快速，高质量）
# - qwen3-tts-instruct-flash（支持指令控制）
# - qwen-audio-turbo（极速）
# - sambert-zhichu-v1（经典模型）
#
# 可选音色：Cherry, Xiaoyun, Zhixu, Aitong, Zhitian 等

# 阿里云 TTS 配置（已弃用，请使用上面的 TTS_SERVICE 配置）
# 保留用于兼容旧版本
ALIYUN_APPKEY=your-appkey-here
ALIYUN_TTS_URL=https://nls-gateway-cn-shanghai.aliyuncs.com/rest/v1/tts/async

# Edge TTS 配置（微软免费，中文支持一般）
# TTS_SERVICE=edge
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Azure TTS 配置（高质量，需付费）
# TTS_SERVICE=azure
# AZURE_TTS_API_KEY=your-azure-api-key-here
# AZURE_TTS_REGION=eastasia
# AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Coqui TTS 配置（本地开源）
# TTS_SERVICE=coqui

# ==================== Vision 服务配置 ====================
# 指定使用哪个 Vision 服务：moondream | qwen-vl-plus | qwen-vl-max
VISION_SERVICE=moondream

# Moondream 本地模型配置
MOONDREAM_USE_CPU=false

# Qwen-VL API 配置（使用 qwen-vl-plus 或 qwen-vl-max 时需要）
QWEN_VL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_API_KEY=your-dashscope-api-key-here


# ==================== MCP Server 配置 ====================
# MCP (Model Context Protocol) Server 通过 config/mcp_servers.json 配置
# 该配置文件支持添加和管理多个 MCP Server
#
# 默认启用的 Server:
#   - playwright: 浏览器自动化（网页导航、点击、输入等）
#
# 可选的 Server（需要在 mcp_servers.json 中启用）:
#   - windows: Windows 系统操作（鼠标、键盘、应用启动）
#   - filesystem: 文件系统操作（读取、写入、搜索）
#   - github: GitHub 操作（仓库管理、Issue、PR）
#
# 配置文件位置: config/mcp_servers.json
# 修改配置后重启程序即可生效

# ==================== 音频设备配置 ====================
# 音频输入设备配置（避免立体声混音问题）
# 运行 python list_audio_devices.py 查看可用设备列表
#
# 如何配置：
# 1. 运行: python list_audio_devices.py
# 2. 找到你的麦克风设备编号（例如：设备 #1）
# 3. 避免选择"立体声混音"、"Stereo Mix"或"What U Hear"设备
# 4. 在下方配置设备编号
#
# 示例：
#   AUDIO_INPUT_DEVICE_INDEX=1    # 你的麦克风设备编号
#   AUDIO_OUTPUT_DEVICE_INDEX=5   # 你的扬声器/耳机设备编号（可选）
#
# 如果不配置，将使用系统默认设备（可能导致视频声音被误收录）

AUDIO_INPUT_DEVICE_INDEX=
AUDIO_OUTPUT_DEVICE_INDEX=
